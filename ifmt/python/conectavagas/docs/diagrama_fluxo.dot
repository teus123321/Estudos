digraph Comunicacao {
  graph [label="Como o ConectaVagas se comunica", labelloc=t, fontsize=22, fontname="DejaVu Sans", bgcolor=white, pad=0.3, ranksep=0.85, nodesep=0.7];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=15, margin=0.24, color="#D8E0EC", fillcolor="#F1F6FF", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=12, color="#3767A6", penwidth=2.0, arrowsize=0.7];
  pessoa [label="Candidato / Empresa\n(cliques e formulários)", fillcolor="#E5EEFA"];
  app [label="app.py\nTelas wxPython", fillcolor="#BDD4FC"];
  banco [label="banco.py\nSQLAlchemy + PyMySQL", fillcolor="#C9EEDB"];
  sql [label="Servidor MySQL\n3 tabelas", fillcolor="#9CE0BA"];
  wb [label="MySQL Workbench\nAdministra o servidor", fillcolor="#DCF5E8"];
  api [label="vagas_api.py\nurllib + JSON", fillcolor="#F7E3B9"];
  adz [label="Serviço Adzuna\nAPI HTTP(S)", fillcolor="#F6D49A"];
  linkedin [label="Site LinkedIn\nAbre no navegador", fillcolor="#EBEFF5"];
  pessoa -> app [label="interage"];
  app -> banco [label="chama funções"];
  banco -> sql [label="SQL / resposta", dir=both];
  wb -> sql [label="consulta tabelas", dir=both, color="#43956C"];
  app -> api [label="consulta externa"];
  api -> adz [label="GET HTTPS / JSON", dir=both, color="#C3932D"];
  app -> linkedin [label="link (não API)", style=dashed, color="#8A95A7"];
  {rank=same; banco; api; linkedin}
  {rank=same; sql; adz}
}
